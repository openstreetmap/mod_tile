{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Release",
      "description": "Release build installed under /usr with FHS paths",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_INSTALL_LOCALSTATEDIR": "/var",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "CMAKE_INSTALL_RUNSTATEDIR": "/run",
        "CMAKE_INSTALL_SYSCONFDIR": "/etc"
      }
    },
    {
      "name": "dev",
      "displayName": "Development",
      "description": "Debug build with tests and extra warnings",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_TESTS": "ON",
        "ENABLE_WARNINGS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer + UBSan",
      "description": "Debug build with tests, instrumented with ASan and UBSan",
      "inherits": "dev",
      "cacheVariables": {
        "ENABLE_SANITIZERS": "address,undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "description": "Debug build with tests, instrumented with TSan (for renderd threading)",
      "inherits": "dev",
      "cacheVariables": {
        "ENABLE_SANITIZERS": "thread"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "dev", "configurePreset": "dev" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0",
        "UBSAN_OPTIONS": "print_stacktrace=1"
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true }
    }
  ]
}
